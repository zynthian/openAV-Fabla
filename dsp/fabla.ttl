  lv2:port [
    a lv2:InputPort ,
      atom:AtomPort ;
    rsz:minimumSize 13448 ;
    atom:bufferType atom:Sequence ;
    atom:supports time:Position ;
    atom:supports midi:MidiEvent,
      patch:Message;
    lv2:index 0 ;
    lv2:designation lv2:control ;
    lv2:symbol "control" ;
    lv2:name "Control"
  ] , [
    a lv2:OutputPort ,
      atom:AtomPort ;
    atom:bufferType atom:Sequence ;
    atom:supports patch:Message;
    lv2:index 1 ;
    lv2:symbol "notify" ;
    lv2:name "Notify";
  ] , [
    a lv2:AudioPort ,
      lv2:OutputPort ;
    lv2:index 2 ;
    lv2:symbol "left" ;
    lv2:name "Audio Output Left";
  ] , [
    a lv2:AudioPort ,
