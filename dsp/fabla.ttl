<http://www.openavproductions.com/fabla>
  a lv2:InstrumentPlugin ;
  doap:name "Fabla" ;
  doap:license <https://spdx.org/licenses/GPL-2.0.html>;
  doap:description "Performance Sampler" ;
  doap:maintainer <http://openavproductions.com/about>;

  lv2:microVersion 2 ;
  lv2:minorVersion 3 ;
  
  lv2:binary <fabla.so> ;
  lv2:requiredFeature urid:map;
  
  lv2:optionalFeature work:schedule ;
  lv2:optionalFeature lv2:hardRTCapable ;
  
  lv2:extensionData state:interface ;
  
  ui:ui <http://www.openavproductions.com/fabla/gui> ;  

  patch:writable
    plug:pad_fpath_1,
